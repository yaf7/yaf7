<svg xmlns="http://www.w3.org/2000/svg" width="800" height="380" viewBox="0 0 800 380" role="img" aria-label="TECH STACK">
  <defs>
    <!-- Background Gradient -->
    <linearGradient id="bg-grad-ts" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#08090c"/>
      <stop offset="100%" stop-color="#0e1017"/>
    </linearGradient>

    <!-- Glow Filters -->
    <filter id="glow-green-ts">
      <feGaussianBlur stdDeviation="2" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>

    <filter id="glow-amber-ts">
      <feGaussianBlur stdDeviation="2.5" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>

    <!-- Background Grid -->
    <pattern id="grid-ts" width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#f59e0b" stroke-width="0.5" opacity="0.05"/>
    </pattern>
  </defs>

  <!-- Background Layer -->
  <rect width="800" height="380" rx="14" fill="url(#bg-grad-ts)"/>
  <rect width="800" height="380" rx="14" fill="url(#grid-ts)"/>

  <!-- Border -->
  <rect x="2" y="2" width="796" height="376" rx="12" fill="none" stroke="#10b981" stroke-width="1.2" opacity="0.4"/>

  <!-- Corner Brackets -->
  <g stroke="#10b981" stroke-width="2" fill="none">
    <path d="M 10 22 V 10 H 22"/>
    <path d="M 778 22 V 10 H 790"/>
    <path d="M 10 358 V 370 H 22"/>
    <path d="M 778 358 V 370 H 790"/>
  </g>

  <!-- Title (Hanya TECH_STACK, tanpa ARSENAL) -->
  <g font-family="'Fira Code', 'JetBrains Mono', monospace" text-anchor="middle">
    <text x="400" y="45" font-size="20" font-weight="800" letter-spacing="4" fill="#f59e0b" filter="url(#glow-amber-ts)">
      ⚡ TECH_STACK
    </text>
  </g>

  <!-- Badges Grid Container -->
